# Use the latest Ray master as base.
FROM rayproject/ray:nightly.260501.1c7c90-py312-tpu

RUN sudo apt-get update && sudo apt-get install -y build-essential g++ gcc cmake ninja-build libopenblas-base libopenmpi-dev libomp-dev
RUN pip uninstall -y torch torchvision

RUN pip install keyrings.google-artifactregistry-auth
RUN pip install pandas==2.3.3



# --- Add torchtitan setup from Dockerfile ---
USER root
WORKDIR /

RUN pip install "jax[tpu]==0.9.1" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html
RUN pip install git+https://github.com/openxla/tokamax.git@8cba6a6a1e52e9efbb7ff8facb66f18f0bfcbe4c
RUN pip install torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install libtpu==0.0.45 -f https://storage.googleapis.com/jax-releases/libtpu_releases.html

ARG AUTH_TOKEN
RUN pip install --pre --no-deps torch_tpu --extra-index-url "https://oauth2accesstoken:${AUTH_TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/"

COPY requirements.txt .
RUN pip install -r requirements.txt
# COPY torchtitan/.ci/docker/requirements-flux.txt .
# RUN pip install -r requirements-flux.txt

RUN pip install 'typeguard==2.13.3'
RUN pip install portpicker absl-py numpy gcsfs frozendict triton fairscale regex tpu-info pathwaysutils numba

# --- Install vllm and vllm-torchtpu ---
ARG GITHUB_USER
ARG GITHUB_TOKEN
RUN git clone --depth 1 --branch v0.27.0 https://github.com/vllm-project/vllm.git
RUN git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/vllm-project/vllm-torchtpu.git /vllm-torchtpu

# Patch vLLM's TPU requirements to accept our local workspace in vllm-torchtpu instead of overriding it
RUN sed -i '/tpu-inference/d' vllm/requirements/tpu.txt && sed -i '/vllm-torchtpu/d' vllm/requirements/tpu.txt

# Install vLLM in editable mode (forcing the 0.19.0 base version to prevent .dev prerelease mismatch during dependency resolution)
WORKDIR /vllm-torchtpu

# Hack pyproject.toml to pin versions
RUN sed -i 's/torch-tpu==[0-9a-zA-Z.]*/torch-tpu==0.1.1.dev20260527102151/' pyproject.toml
RUN sed -i 's/libtpu==[0-9a-zA-Z.]*/libtpu==0.0.45/' pyproject.toml

RUN pip install setuptools-rust setuptools-scm ninja cmake wheel &&     pip install -r ../vllm/requirements/common.txt &&     SETUPTOOLS_SCM_PRETEND_VERSION=0.27.0 VLLM_TARGET_DEVICE="tpu" pip install --no-build-isolation --no-deps -e ../vllm
RUN pip install --no-deps -e .

WORKDIR /app
COPY torchtitan ./torchtitan
# Add both /app and /app/torchtitan to PYTHONPATH so that both
# standard package style (import torchtitan.*) and standalone module style
# (import experiments.*) imports work seamlessly on both head and worker nodes.
ENV PYTHONPATH="${PYTHONPATH}:/app:/app/torchtitan"
